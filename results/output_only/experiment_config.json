{
  "seed": 42,
  "batch_size": 32,
  "maximum_epochs": 30,
  "patience": 5,
  "learning_rate": 0.001,
  "weight_decay": 0.0001,
  "embedding_dimension": 128,
  "dropout": 0.5,
  "checkpoint_selection": "minimum validation loss",
  "preprocessing": {
    "input_mode": "output_only",
    "vocab_size": 5153,
    "max_length": 160,
    "label_mapping": {
      "Claude": 0,
      "DeepSeek": 1,
      "GPT": 2
    },
    "padding_id": 0,
    "unknown_id": 1,
    "token_pattern": "\\n|[A-Za-z0-9_]+|[^\\s]",
    "length_selection": "training 95th percentile, capped at 512"
  },
  "torch_version": "2.14.1+cpu"
}